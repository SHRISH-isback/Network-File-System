# NFS Web Application Configuration
# Copy this file to .env and update with your settings

# Name Server Configuration
# Set this to the IP address of the laptop running the Name Server
NM_HOST=127.0.0.1

# Name Server Port
NM_PORT=8080

# Web Application Configuration
# Port for local development (Vercel will use its own port in production)
WEB_PORT=3000

# Web Host (use 0.0.0.0 to allow external connections)
WEB_HOST=0.0.0.0

# Node Environment
NODE_ENV=development

# Session Secret Key (generate a random string for production)
SECRET_KEY=your-secret-key-here-change-this-in-production

# Example for multi-machine setup:
# If Name Server is on laptop with IP 192.168.1.100
# NM_HOST=192.168.1.100
# NM_PORT=8080
